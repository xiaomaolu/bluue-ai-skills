<script>
(function(){
  const T=__T__;
  const RENDER=location.hash==="#render";
  if(RENDER) document.documentElement.classList.add("render");
  const reduce=matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp=v=>v<0?0:v>1?1:v;
  const eio=x=>x<.5?4*x*x*x:1-Math.pow(-2*x+2,3)/2, eo=x=>1-Math.pow(1-x,3), expo=x=>x>=1?1:1-Math.pow(2,-10*x);
  const ss=x=>x*x*(3-2*x);
  const back=x=>{if(x<=0)return 0;if(x>=1)return 1;const c=1.6;return 1+(c+1)*Math.pow(x-1,3)+c*Math.pow(x-1,2);};
  document.querySelectorAll(".draw").forEach(el=>el.setAttribute("pathLength","1"));
  const turb=document.getElementById("turb");
  const ANIM={
    shrink(el,lt){const a=+el.dataset.a,b=+el.dataset.b,cx=+el.dataset.cx,cy=+el.dataset.cy;const u=eio(clamp((lt-a)/(b-a)));const s=Math.max(0.0001,1-u);
      el.setAttribute("transform",`translate(${cx} ${cy}) scale(${s.toFixed(4)}) translate(${-cx} ${-cy})`);el.style.opacity=(1-u*u).toFixed(3);},
    scroll(el,lt){el.setAttribute("transform",`translate(${(-((lt*95)%760)).toFixed(1)} 0)`);},
    vane(el,lt){const a=+el.dataset.a;const p=Math.max(0,lt-a);const ang=28*Math.sin(p*2.4)*Math.exp(-p*0.15)+6*Math.sin(p*5.1);const v=el.querySelector(".vn");if(v)v.setAttribute("transform",`rotate(${ang.toFixed(2)})`);},
    typedel(el,lt){const a=+el.dataset.a;const full=[...el.dataset.full];const p=lt-a;let n=0;
      if(p<0)n=0;else if(p<1.1)n=Math.ceil(full.length*p/1.1);else if(p<1.7)n=full.length;else n=Math.max(0,full.length-Math.floor((p-1.7)/0.11));
      const cur=(Math.floor(lt*2.5)%2===0)?"|":" ";el.textContent=full.slice(0,n).join("")+(p>-0.5?cur:"");},
    needle(el,lt){const a=+el.dataset.a,b=+el.dataset.b,v0=+el.dataset.v0,v1=+el.dataset.v1;const u=clamp((lt-a)/(b-a));const v=v0+(v1-v0)*expo(u)+0.012*Math.sin(lt*9)*(u>0?1:0);
      el.setAttribute("transform",`translate(${el.dataset.cx} ${el.dataset.cy}) rotate(${(-180*(1-v)).toFixed(2)})`);},
    pan(el,lt){const a=+el.dataset.a,b=+el.dataset.b;const u=eio(clamp((lt-a)/(b-a)));const x=-200*Math.sin(u*Math.PI*1.5);el.setAttribute("transform",`translate(${x.toFixed(1)} 0)`);},
    hand(el,lt){const a=+el.dataset.a,b=+el.dataset.b;const u=eio(clamp((lt-a)/(b-a)));const ang=360-(360-228)*u;
      const m=el.getAttribute("d").match(/M([\d.]+) ([\d.]+)/);el.setAttribute("transform",`rotate(${ang.toFixed(1)} ${m[1]} ${m[2]})`);},
    fill(el,lt){const a=+el.dataset.a,b=+el.dataset.b;const u=eio(clamp((lt-a)/(b-a)));el.firstElementChild.setAttribute("width",(252*u).toFixed(1));},
    shave(el,lt){const a=+el.dataset.a,b=+el.dataset.b;const u=eio(clamp((lt-a)/(b-a)));el.setAttribute("transform",`translate(${(160*u).toFixed(1)} ${(-140*u).toFixed(1)}) rotate(${(40*u).toFixed(1)} 800 580)`);el.style.opacity=(1-u).toFixed(3);},
    tilt(el,lt){const a=+el.dataset.a,b=+el.dataset.b;const u=back(clamp((lt-a)/(b-a)));el.setAttribute("transform",`rotate(${(-12*u).toFixed(2)} ${el.dataset.cx} ${el.dataset.cy})`);},
    shout(el,lt){const a=+el.dataset.a;const p=lt-a;el.style.opacity=p<0?0:(0.55+0.45*Math.abs(Math.sin(p*4))).toFixed(3);}
  };
  const scenes=[...document.querySelectorAll(".scene")].map((g,i)=>{
    const s=+g.dataset.s,e=+g.dataset.e;
    const items=[...g.querySelectorAll("[data-at]")].map(el=>{const cl=el.classList;
      const kind=cl.contains("ink")?"ink":cl.contains("draw")?"draw":cl.contains("slide")?"slide":cl.contains("scale")?"scale":cl.contains("pop")?"pop":"fade";
      return {el,kind,at:+el.dataset.at,out:el.dataset.out!=null?+el.dataset.out:null,c:el.dataset.c?el.dataset.c.split(",").map(Number):null,
        from:el.dataset.from?el.dataset.from.split(",").map(Number):[0,0],sx0:+(el.dataset.sx0||1),sy0:+(el.dataset.sy0||1),
        d:+(el.dataset.d||(kind==="fade"?0.6:kind==="ink"?0.5:kind==="pop"?0.5:kind==="slide"?0.8:kind==="draw"?0.9:0.9))};});
    return {g,s,e,items,anims:[...g.querySelectorAll("[data-anim]")],i};
  });
  let t=0,playing=false,last=null;
  const scrub=document.getElementById("scrub"),timeEl=document.getElementById("time");scrub.max=T;
  const fmt=s=>{s=Math.max(0,Math.floor(s));return Math.floor(s/60)+":"+String(s%60).padStart(2,"0");};
  const XF=0.7;
  function render(){
    turb.setAttribute("seed",String(1+Math.floor(t*8)%4));
    for(const sc of scenes){
      let op=0;
      if(t>=sc.s&&t<=sc.e+XF){const fi=sc.i===0?1:ss(clamp((t-sc.s)/XF)),fo=t<=sc.e?1:ss(clamp((sc.e+XF-t)/XF));op=Math.min(fi,fo);}
      if(sc.i===scenes.length-1&&t>=sc.s)op=sc.i===0?1:ss(clamp((t-sc.s)/XF));
      sc.g.style.opacity=op.toFixed(3);sc.g.style.display=op>0?"inline":"none";if(op<=0)continue;
      const lt=t-sc.s;
      for(const it of sc.items){
        let p=clamp((lt-it.at)/it.d);if(sc.i===0&&it.at<=0)p=1;
        const o=it.out==null?1:1-clamp((lt-it.out)/0.4);
        if(it.kind==="ink"){const e=eo(p);const s=1.18-0.18*e;it.el.setAttribute("transform",`translate(${it.c[0]} ${it.c[1]}) scale(${s.toFixed(4)}) translate(${-it.c[0]} ${-it.c[1]})`);it.el.style.opacity=(e*o).toFixed(3);}
        else if(it.kind==="draw"){it.el.style.strokeDashoffset=1-eio(p);it.el.style.opacity=p>0?o:0;}
        else if(it.kind==="slide"){const e=expo(p);it.el.setAttribute("transform",`translate(${(it.from[0]*(1-e)).toFixed(2)} ${(it.from[1]*(1-e)).toFixed(2)})`);it.el.style.opacity=(clamp(p*2)*o).toFixed(3);}
        else if(it.kind==="scale"||it.kind==="pop"){const e=it.kind==="pop"?eo(p):expo(p);const sx=it.kind==="pop"?0.3+0.7*e:it.sx0+(1-it.sx0)*e,sy=it.kind==="pop"?0.3+0.7*e:it.sy0+(1-it.sy0)*e;
          it.el.setAttribute("transform",`translate(${it.c[0]} ${it.c[1]}) scale(${Math.max(sx,0.0001).toFixed(4)} ${Math.max(sy,0.0001).toFixed(4)}) translate(${-it.c[0]} ${-it.c[1]})`);it.el.style.opacity=(clamp(p*2.5)*o).toFixed(3);}
        else{it.el.style.opacity=(eo(p)*o).toFixed(3);}
      }
      for(const el of sc.anims){const f=ANIM[el.dataset.anim];if(f)f(el,lt);}
    }
    scrub.value=t;timeEl.textContent=fmt(t)+" / "+fmt(T);
  }
  const playBtn=document.getElementById("play"),icon=document.getElementById("playIcon"),audio=document.getElementById("narr");
  function setPlaying(v){playing=v;last=null;icon.setAttribute("d",v?"M7 5h4v14H7zM13 5h4v14h-4z":"M8 5v14l11-7z");playBtn.setAttribute("aria-label",v?"暂停":"播放");
    if(v){const c=document.getElementById("cover");if(c)c.style.opacity=0;}
    if(audio){if(v){try{audio.currentTime=t;}catch(e){}const pr=audio.play();if(pr&&pr.catch)pr.catch(()=>{});}else audio.pause();}}
  function frame(now){if(playing){if(last!==null)t+=Math.min(0.1,(now-last)/1000);last=now;
      if(audio&&!audio.paused&&Math.abs(audio.currentTime-t)>0.25)t=audio.currentTime;if(t>=T){t=T;setPlaying(false);}render();}
    requestAnimationFrame(frame);}
  playBtn.addEventListener("click",()=>{if(!playing&&t>=T)t=0;setPlaying(!playing);});
  document.getElementById("stage").addEventListener("click",()=>playBtn.click());
  document.getElementById("replay").addEventListener("click",()=>{t=0;render();setPlaying(true);});
  scrub.addEventListener("input",()=>{t=+scrub.value;render();});
  scrub.addEventListener("change",()=>{if(audio){try{audio.currentTime=t;}catch(e){}}});
  document.addEventListener("keydown",e=>{if(e.code==="Space"&&e.target.tagName!=="INPUT"&&e.target.tagName!=="BUTTON"){e.preventDefault();playBtn.click();}});
  window.__seek=function(tt){t=tt;render();};window.__T=T;
  render();
  if(RENDER) return;
  requestAnimationFrame(frame);
})();
</script>
