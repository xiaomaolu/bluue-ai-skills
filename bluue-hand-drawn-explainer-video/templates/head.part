<title>沉默的螺旋</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&display=swap">
<style>
/* Hand-drawn 9:16 film: off-white paper, bold black line art, one orange signal colour. Single deliberate light look for the film card. */
:root{
  --desk:#16130f; --desk-2:#29241e;
  --paper:#fbfaf7; --ink:#141414; --mute:#8a8a86; --rule:#deded8; --red:#6c47ff;
  --kai:"WK","LXGW WenKai","Kaiti SC","STKaiti","KaiTi",serif;
  --sans:"Noto Sans SC","Noto Sans CJK SC","PingFang SC",sans-serif;
  color-scheme:dark;
}
html,body{height:100%}
body{margin:0;background:var(--desk);color:#efe9df;font-family:var(--sans);
  padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));box-sizing:border-box}
main{min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding-block:16px;box-sizing:border-box}
.stage{position:relative;height:min(calc(100vh - 100px), calc((100vw - 32px) * 16 / 9));height:min(calc(100dvh - 100px), calc((100vw - 32px) * 16 / 9));aspect-ratio:9/16;
  border-radius:12px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.5);cursor:pointer;background:var(--paper)}
.stage svg{display:block;width:100%;height:100%}
.cover{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:10px;padding-bottom:18%;pointer-events:none;transition:opacity .4s}
.cover span{width:58px;height:58px;border-radius:50%;background:var(--red);color:#fff;display:grid;place-items:center;font-size:22px;padding-left:4px;box-sizing:border-box}
.cover em{font-style:normal;font-size:13px;letter-spacing:2px;color:var(--ink);background:rgba(243,239,230,.92);padding:4px 12px;border-radius:20px}
.bar{width:min(100%, 520px);display:flex;align-items:center;gap:10px}
.bar button{appearance:none;border:0;background:var(--desk-2);color:#efe9df;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;cursor:pointer;flex:none}
.bar button:hover{background:#3a332b}
.bar button:focus-visible,.bar input:focus-visible,.stage:focus-visible{outline:2px solid #e3a294;outline-offset:2px}
.bar svg{width:18px;height:18px;fill:currentColor}
.bar input[type=range]{flex:1;min-width:0;accent-color:var(--red)}
.time{font-variant-numeric:tabular-nums;font-size:13px;color:#a79e92;flex:none}
svg text{font-family:var(--sans);fill:var(--ink)}
.t{font-family:var(--sans);fill:var(--ink)}
.o{fill:var(--red)}
.foot{font-family:var(--sans);font-size:22px;fill:var(--mute)}
.rough{filter:url(#rough)}
.rough *{stroke-linecap:round;stroke-linejoin:round}
.sans{font-family:var(--sans)}
.r,.kai.r{fill:var(--red)}
.sub{font-family:var(--sans);font-weight:700;font-size:50px;text-anchor:middle;fill:var(--ink);letter-spacing:1px}
.draw{stroke-dasharray:1 2;stroke-dashoffset:1}
html.render body{padding:0;background:var(--paper)}
html.render main{padding:0;display:block}
html.render .stage{width:1080px;height:1920px;border-radius:0;box-shadow:none}
html.render .bar,html.render .cover{display:none}
</style>
<main>
  <div class="stage" id="stage" tabindex="0" aria-label="动画画面，点击播放或暂停">
  <svg viewBox="0 0 1080 1920" role="img" aria-label="手绘动画：沉默的螺旋">
    <defs>
      <filter id="rough" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence id="turb" type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3"/><feDisplacementMap in="SourceGraphic" scale="3.2"/></filter>
      <pattern id="hatch" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="18" height="18" fill="#fbfaf7"/><rect width="6" height="18" fill="#6c47ff"/></pattern>
      <clipPath id="win"><rect x="180" y="450" width="720" height="410" rx="38"/></clipPath>
    </defs>
    <rect width="1080" height="1920" fill="var(--paper)"/>
    <text x="90" y="170" style="font-weight:900;font-size:40px">沉默的螺旋</text>
    <text x="90" y="212" style="font-weight:500;font-size:22px;fill:var(--mute);letter-spacing:4px">THE SPIRAL OF SILENCE</text>
    <text x="990" y="170" text-anchor="end" style="font-size:24px;fill:var(--mute)">蓝与蓝之间的ai差值</text>
<!--SCENES-->
  </svg>
  <div class="cover" id="cover"><span>▶</span><em>点击播放 · 有声</em></div>
  </div>
  <div class="bar">
    <button id="play" aria-label="播放"><svg viewBox="0 0 24 24"><path id="playIcon" d="M8 5v14l11-7z"/></svg></button>
    <input id="scrub" type="range" min="0" max="__T__" step="0.01" value="0" aria-label="播放进度">
    <span class="time" id="time">0:00</span>
    <button id="replay" aria-label="从头播放"><svg viewBox="0 0 24 24"><path d="M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg></button>
  </div>
</main>
<!--AUDIO-->
